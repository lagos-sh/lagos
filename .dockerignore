# Build artifacts. Without this the whole target/ tree (multiple GB) is uploaded
# to the daemon as build context on every build.
target/

.git/
.github/
tests/
docs/
k8s/
*.md
.env
.env.*
!.env.example

# Local-only cargo config: it redirects `target-dir` outside the repo, which
# would break `COPY --from=build /src/target/...` in the runtime stage.
.cargo/
